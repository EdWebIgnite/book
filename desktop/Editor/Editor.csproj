<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The book editor for illustrators and writers: BookEditor.exe. It is a separate program on purpose.
    The reader apps (Player and Phone) never reference this project, so children and parents can't
    reach it from a reader.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BookEditor</AssemblyName>
    <RootNamespace>BookEditor</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The dassie over a book with a pencil, on cream (drawn by Reader.Ui.AppIcon, made with BookEditor and its make-icons option). -->
    <ApplicationIcon>Assets\dassie-editor.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <!-- Draws the window with no screen attached, for the screenshot hook. -->
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <!--
      "Time words automatically": free speech recognition that runs on the computer, with no internet
      once its file of speech knowledge has been downloaded (see Editor.Core/SpeechModel.cs). MIT licensed.
      The runtime packages carry the native code for Windows, Linux and macOS; NoAvx is for older
      processors without AVX, which the main one can't run on.
    -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
  </ItemGroup>

  <!--
    Publishing for one system (publish-editor.sh does win-x64): the speech recogniser's native code
    stays as files beside BookEditor.exe in runtimes/, where Whisper.net looks for it, instead of being
    packed inside the single exe (from where it couldn't find it). Only the files for that system go in.
  -->
  <Target Name="KeepSpeechCodeBesideTheExe" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_OtherSpeechCode Include="@(ResolvedFileToPublish)"
                        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/'))
                                   And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/$(RuntimeIdentifier)/'))
                                   And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/noavx/$(RuntimeIdentifier)/'))" />
      <_OtherSpeechCode Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'ggml-metal.metal' And !$(RuntimeIdentifier.StartsWith('osx'))" />
      <ResolvedFileToPublish Remove="@(_OtherSpeechCode)" />
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Reader.Core\Reader.Core.csproj" />
    <ProjectReference Include="..\Reader.Avalonia\Reader.Avalonia.csproj" />
    <ProjectReference Include="..\Reader.Audio\Reader.Audio.csproj" />
    <ProjectReference Include="..\Editor.Core\Editor.Core.csproj" />
  </ItemGroup>
</Project>
